<?xml version="1.0" encoding="utf-8"?>
<!-- The icon art is a full square; inset it so launchers that mask to a circle keep Rufus's ears. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/sky" />
    <foreground>
        <inset android:drawable="@drawable/icon_art" android:inset="11%" />
    </foreground>
</adaptive-icon>
